#!ipxe

echo "now in logic.ipxe"
set repo http://192.168.10.26:8080

# kernel ${repo}/os/images/pxeboot/vmlinuz ip=dhcp inst.ks=${repo}/OS.ks inst.stage2=${repo}/os/images/install.img
